<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ assessment.name }} — Security assessment report</title>
  <style>
    @page { size: A4; margin: 20mm 16mm; }
    body { font-family: "DejaVu Sans", Arial, sans-serif; font-size: 10.5pt; color: #1b1b1b; line-height: 1.45; }
    h1, h2, h3 { color: #14324a; page-break-after: avoid; }
    h1 { font-size: 24pt; margin: 0 0 6mm; }
    h2 { font-size: 15pt; border-bottom: 1px solid #9fb3c4; padding-bottom: 2mm; margin-top: 10mm; }
    h3 { font-size: 12pt; margin: 6mm 0 2mm; }
    table { width: 100%; border-collapse: collapse; margin: 3mm 0; }
    th, td { border: 1px solid #c7d2dc; padding: 2mm; text-align: left; vertical-align: top; }
    th { background: #eef3f7; }
    pre { white-space: pre-wrap; word-break: break-word; background: #f6f8fa; border: 1px solid #d8dee4; padding: 2mm; font-size: 8.5pt; }
    .muted { color: #5d6b78; }
    .cover { min-height: 220mm; display: flex; flex-direction: column; justify-content: center; }
    .cover .meta { margin-top: 12mm; }
    .finding { page-break-inside: avoid; border-top: 2px solid #14324a; padding-top: 3mm; margin-top: 6mm; }
    .badge { display: inline-block; padding: 0.5mm 2mm; border-radius: 2mm; color: #fff; font-size: 9pt; }
    .sev-critical { background: #7f1d1d; }
    .sev-high { background: #b91c1c; }
    .sev-medium { background: #b45309; }
    .sev-low { background: #0f766e; }
    .sev-info { background: #475569; }
    ul, ol { margin: 2mm 0 2mm 6mm; }
    footer { margin-top: 8mm; font-size: 8.5pt; color: #5d6b78; }
    .page-break { page-break-before: always; }
  </style>
</head>
<body>
  <section class="cover">
    <p class="muted">PenPal security assessment report</p>
    <h1>{{ assessment.name }}</h1>
    <p><strong>Target:</strong> {{ assessment.target_name }}{% if assessment.target_base_url %} — {{ assessment.target_base_url }}{% endif %}</p>
    <div class="meta">
      <p><strong>Generated:</strong> {{ generated_at }}</p>
      <p><strong>Generated by:</strong> {{ generated_by_name }}</p>
      <p><strong>Authorization holder:</strong> {{ assessment.owner_name }}</p>
      <p><strong>Authorization reference:</strong> {{ assessment.authorization_reference }}</p>
      <p><strong>Assessment status:</strong> {{ assessment.status.value }}</p>
    </div>
    <p class="muted">
      Only assessor-confirmed findings appear in the main report. AI output is advisory and
      was verified by a human assessor. Unverified AI suggestions are not presented as findings.
    </p>
  </section>

  <section class="page-break">
    <h2>1. Scope and authorization</h2>
    <p><strong>Target description:</strong> {{ assessment.target_description or "Not provided." }}</p>
    <p><strong>Hosting environment:</strong> {{ assessment.hosting_environment or "Not recorded." }}</p>
    <p><strong>Authorization confirmed:</strong> {{ "Yes" if assessment.authorization_confirmed else "No" }}</p>
    <table>
      <thead><tr><th>Direction</th><th>Kind</th><th>Value</th><th>Note</th></tr></thead>
      <tbody>
        {% for item in scope_in %}
        <tr><td>In scope</td><td>{{ item.kind.value }}</td><td>{{ item.value }}</td><td>{{ item.note or "" }}</td></tr>
        {% endfor %}
        {% for item in scope_out %}
        <tr><td>Out of scope</td><td>{{ item.kind.value }}</td><td>{{ item.value }}</td><td>{{ item.note or "" }}</td></tr>
        {% endfor %}
        {% if not scope_in and not scope_out %}
        <tr><td colspan="4">No scope items recorded.</td></tr>
        {% endif %}
      </tbody>
    </table>

    <h2>2. Methodology</h2>
    <p>
      The assessment followed an eight-stage process: scope definition, reconnaissance,
      scanning, security assessment, AI-assisted analysis, human verification, risk
      assessment and reporting. Framework references: OWASP Web Security Testing Guide,
      OWASP Top 10 (2021), CWE, NIST SP 800-115 and PTES.
    </p>
    <p><strong>Assessment categories:</strong> {{ selected_categories|join(", ") if selected_categories else "None recorded" }}</p>
    <p><strong>Tools and versions:</strong> {{ tool_summary if tool_summary else "No scans recorded." }}</p>

    <h2>3. Executive summary</h2>
    <p>{{ narrative }}</p>
    <table>
      <thead><tr><th>Severity</th><th>Confirmed findings</th></tr></thead>
      <tbody>
        {% for severity, count in severity_rows %}
        <tr><td>{{ severity }}</td><td>{{ count }}</td></tr>
        {% endfor %}
        <tr><th>Total confirmed</th><th>{{ confirmed_total }}</th></tr>
      </tbody>
    </table>
    <p class="muted">
      Severity shown here is the assessor's final severity. Tool and AI severities are
      advisory and may differ.
    </p>
  </section>

  <section class="page-break">
    <h2>4. Confirmed findings</h2>
    {% if not findings %}
    <p>No findings were confirmed.</p>
    {% endif %}
    {% for finding in findings %}
    {% set sev = finding.final_severity.value if finding.final_severity else "unknown" %}
    <article class="finding">
      <span class="badge sev-{{ sev }}">{{ sev|upper }}</span>
      <h3>{{ loop.index }}. {{ finding.title }}</h3>
      <table>
        <tbody>
          <tr><th>Category</th><td>{{ finding.category.value }}</td></tr>
          <tr><th>OWASP / CWE</th><td>{{ finding.owasp_category or "Not mapped" }}{% if finding.cwe %} / {{ finding.cwe }}{% endif %}</td></tr>
          <tr><th>Endpoint</th><td>{{ finding.affected_url or "Not recorded" }}{% if finding.http_method %} ({{ finding.http_method }}){% endif %}{% if finding.parameter %} — parameter {{ finding.parameter }}{% endif %}</td></tr>
          <tr><th>Tool / confidence</th><td>{{ finding.source.value }}{% if finding.tool_confidence %} / {{ finding.tool_confidence }}{% endif %}</td></tr>
          <tr><th>Assistant-suggested severity</th><td>{{ finding.ai_suggested_severity.value if finding.ai_suggested_severity else "Not available" }}</td></tr>
          <tr><th>Likelihood / impact</th><td>{{ finding.likelihood if finding.likelihood is not none else "not set" }} / {{ finding.impact if finding.impact is not none else "not set" }}</td></tr>
          <tr><th>Verified by</th><td>User {{ finding.verified_by or "unknown" }} at {{ finding.verified_at or "unknown time" }}</td></tr>
        </tbody>
      </table>
      <h4>Description</h4>
      <p>{{ finding.description or "No description." }}</p>
      <h4>Evidence</h4>
      {% set items = evidence_by_finding.get(finding.id, []) %}
      {% if not items %}
      <p class="muted">No evidence items recorded.</p>
      {% endif %}
      {% for evidence in items %}
      <p><strong>{{ evidence.type.value }}</strong>{% if evidence.filename %} — file {{ evidence.filename }}{% endif %}{% if evidence.sha256 %} — SHA-256 <code>{{ evidence.sha256 }}</code>{% endif %}</p>
      {% if evidence.content %}<pre>{{ evidence.content }}</pre>{% endif %}
      {% endfor %}
      <h4>Final remediation</h4>
      <p>{{ finding.final_remediation or "No remediation recorded." }}</p>
    </article>
    {% endfor %}
  </section>

  <section class="page-break">
    <h2>Appendix A — Other verification outcomes</h2>
    <table>
      <thead><tr><th>Verification status</th><th>Count</th></tr></thead>
      <tbody>
        {% for status, count in appendix_verification_rows %}
        <tr><td>{{ status }}</td><td>{{ count }}</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h2>Appendix B — AI usage and data handling</h2>
    <p>
      AI output is advisory. Every finding in the main report was verified by a human
      assessor, who set the final severity and remediation. Target content sent to the
      provider was redacted first: cookies, authorization headers, tokens, passwords,
      API keys, query values, userinfo and hostnames, email addresses, phone numbers,
      card-like numbers and IP addresses are replaced with typed placeholders.
    </p>
    {% if ai_usage %}
    <table>
      <thead><tr><th>Provider</th><th>Model</th><th>Analyses</th></tr></thead>
      <tbody>
        {% for item in ai_usage %}
        <tr><td>{{ item.provider }}</td><td>{{ item.model }}</td><td>{{ item.count }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p>No AI analyses were recorded for this assessment.</p>
    {% endif %}
    {% if redaction_summary %}
    <p><strong>Redaction summary:</strong>
      {% for kind, count in redaction_summary.items() %}{{ kind }}={{ count }}{% if not loop.last %}, {% endif %}{% endfor %}
    </p>
    {% endif %}

    <h2>Appendix C — Scan log</h2>
    <table>
      <thead><tr><th>Tool</th><th>Profile</th><th>Status</th><th>Started</th><th>Finished</th><th>Duration (s)</th><th>Tool version</th></tr></thead>
      <tbody>
        {% for scan in scan_history %}
        <tr>
          <td>{{ scan.tool.value }}</td>
          <td>{{ scan.profile }}</td>
          <td>{{ scan.status.value }}</td>
          <td>{{ scan.started_at or "" }}</td>
          <td>{{ scan.finished_at or "" }}</td>
          <td>{{ "%.1f"|format(scan.duration_seconds) if scan.duration_seconds is not none else "" }}</td>
          <td>{{ scan.tool_version or "" }}</td>
        </tr>
        {% endfor %}
        {% if not scan_history %}
        <tr><td colspan="7">No scans recorded.</td></tr>
        {% endif %}
      </tbody>
    </table>
  </section>

  <footer>
    Generated by PenPal. Confirmed findings only. Evidence excerpts are truncated for the
    report; full raw output and hashes remain in the assessment record.
  </footer>
</body>
</html>
